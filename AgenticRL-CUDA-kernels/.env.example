# Example environment variables.
# Copy this file to .env and replace the placeholder values.
# Never commit real secrets; .env is gitignored, this file is not.

# Modal credentials
# Create a token at https://modal.com/settings/tokens or with `modal token new`.
MODAL_TOKEN_ID=ak-your-token-id
MODAL_TOKEN_SECRET=as-your-token-secret

# Optional: Modal environment to deploy into (defaults to the workspace default).
# MODAL_ENVIRONMENT=main
