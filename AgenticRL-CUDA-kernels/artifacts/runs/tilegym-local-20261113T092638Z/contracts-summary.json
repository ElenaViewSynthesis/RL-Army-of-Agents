  "token_kl_div": {
   "tier": 2,
   "status": "new",
   "proposed_stage": 7,
   "reference": "t=log_target.float(); y=log_pred.float(); row=(t.exp()*(t-y)).sum(-1); return (row, row.mean())  # KL(target || pred), batchmean",
